# Copiez ce fichier en ".env" (dans le dossier backend) et adaptez les valeurs.
# Le fichier .env ne doit JAMAIS être partagé ni versionné.

# --- Sécurité ---
# En production : DJANGO_DEBUG=False et une clé secrète longue et aléatoire
# (python -c "from django.core.management.utils import get_random_secret_key as k; print(k())")
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=

# --- Réseau local (Wi-Fi de l'établissement) ---
# True : les téléphones, tablettes et autres ordinateurs du même réseau peuvent ouvrir
# l'application (actif par défaut quand DJANGO_DEBUG=True).
# False : accès limité aux adresses listées dans DJANGO_ALLOWED_HOSTS (mise en ligne).
# RESEAU_LOCAL=True
# DJANGO_ALLOWED_HOSTS=ecole.exemple.org

# Fuseau horaire de l'établissement (ex. Europe/Paris, Africa/Dakar, Indian/Antananarivo)
# TIME_ZONE=Europe/Paris

# Dossier des photos et pièces jointes (défaut : backend/media). Pensez à le sauvegarder.
# MEDIA_ROOT=

# --- Base de données ---
# sqlite (défaut si la ligne est absente) : rien à installer, fichier backend/db.sqlite3.
# mysql : MySQL local ; installez alors aussi  pip install -r requirements-mysql.txt
# (Sur Render, DATABASE_URL est fourni automatiquement et prend le dessus : voir DEPLOY.md.)
DB_ENGINE=sqlite
DB_NAME=gestion_scolaire_v1
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Compte administrateur créé au démarrage (utile en ligne, sans terminal) ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_RESET_PASSWORD=False

# --- CORS : adresses du frontend autorisées ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Règle de passage ---
# Moyenne annuelle minimale pour être « passant » à la clôture de l'année
SEUIL_PASSAGE=10

# --- Finances ---
# Devise affichée sur les reçus et les états (Ar, €, FCFA...)
# DEVISE=Ar
